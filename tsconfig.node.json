{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "types": ["node"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src", "scripts", "tests"],
    "exclude": [
        "hooks",
        "node_modules",
        "**/*.test.ts",
        "src/host/engine-host.ts",
        "src/host/engine-host.spec.ts",
        "src/host/engine-transcript.ts"
    ]
}
